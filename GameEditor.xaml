<Window x:Class="BorderlessMax.GameEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BorderlessMax"
        Style="{StaticResource Win}" Title="{Binding [edit_title], Source={x:Static local:L.I}}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24,20,24,20">
    <DockPanel Margin="0,0,0,16">
      <Image Source="{Binding GameIcon, TargetNullValue={StaticResource AppGlyph}}" Width="32" Height="32" Margin="0,0,12,0" />
      <TextBlock Style="{StaticResource Title}" Text="{Binding [edit_title], Source={x:Static local:L.I}}" Margin="0" VerticalAlignment="Center" />
    </DockPanel>

    <TextBlock Style="{StaticResource Label}" Text="{Binding [name], Source={x:Static local:L.I}}" />
    <TextBox Text="{Binding GameName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [name], Source={x:Static local:L.I}}" />

    <TextBlock Style="{StaticResource Label}" Margin="0,16,0,8" Text="{Binding [exe], Source={x:Static local:L.I}}" />
    <TextBox Text="{Binding Exe, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [exe], Source={x:Static local:L.I}}" />
    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding [exe_hint], Source={x:Static local:L.I}}" />

    <TextBlock Style="{StaticResource Label}" Margin="0,16,0,8" Text="{Binding [window], Source={x:Static local:L.I}}" />
    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding KeepFrame}" Content="{Binding [keep_frame], Source={x:Static local:L.I}}" />
    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding [keep_frame_hint], Source={x:Static local:L.I}}" />

    <!-- borderless only: the size -->
    <StackPanel Visibility="{Binding Borderless, Converter={StaticResource Vis}}">
      <TextBlock Style="{StaticResource Label}" Margin="0,16,0,8" Text="{Binding [resolution], Source={x:Static local:L.I}}" />
      <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseDefault}" Content="{Binding DefaultText}" Margin="0,0,0,12" />
      <ContentControl Content="{Binding Size}" ContentTemplate="{StaticResource ResolutionPicker}" Focusable="False"
                      IsEnabled="{Binding OwnSize}" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Style="{StaticResource GreyButton}" MinHeight="38" IsCancel="True" Content="{Binding [cancel], Source={x:Static local:L.I}}" />
      <Button Style="{StaticResource Primary}" MinHeight="38" MinWidth="110" Margin="8,0,0,0" IsDefault="True" Click="Save_Click"
              IsEnabled="{Binding Valid}" Content="{Binding [save], Source={x:Static local:L.I}}" />
    </StackPanel>
  </StackPanel>
</Window>
