<Window x:Class="BorderlessMax.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BorderlessMax"
        Style="{StaticResource Win}" Title="borderlessMax" Width="1130" Height="760" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate DataType="{x:Type local:GameRow}">
      <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8"
              Padding="12,8" Margin="0,0,0,8">
        <DockPanel>
          <Image DockPanel.Dock="Left" Source="{Binding Icon, TargetNullValue={StaticResource AppGlyph}}" Width="28" Height="28" Margin="0,0,12,0" />
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="Remove_Click" Margin="4,0,0,0"
                  ToolTip="{Binding [remove], Source={x:Static local:L.I}}" AutomationProperties.Name="{Binding [remove], Source={x:Static local:L.I}}">
            <Path Data="{StaticResource Cross}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" />
          </Button>
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="Edit_Click" Margin="12,0,0,0"
                  ToolTip="{Binding [edit], Source={x:Static local:L.I}}" AutomationProperties.Name="{Binding [edit], Source={x:Static local:L.I}}">
            <Path Data="{StaticResource Pencil}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" />
          </Button>
          <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Margin="16,0,0,0"
                    VerticalAlignment="Center" ToolTip="{Binding [enabled], Source={x:Static local:L.I}}"
                    AutomationProperties.Name="{Binding [enabled], Source={x:Static local:L.I}}" />
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding Size}" Foreground="{StaticResource Header}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SizeInfo}" Foreground="{StaticResource Muted}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Header}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Exe}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- header: logo, subtitle, language -->
    <Border Style="{StaticResource Card}" Padding="16,12">
      <DockPanel>
        <ComboBox DockPanel.Dock="Right" Width="170" MinHeight="30" ItemsSource="{Binding LangItems}" SelectedValuePath="Code"
                  SelectedValue="{Binding Lang}" AutomationProperties.Name="Language">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Flag}" Width="22" Height="15" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Name}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock DockPanel.Dock="Right" Text="{Binding [subtitle], Source={x:Static local:L.I}}" Style="{StaticResource Hint}"
                   VerticalAlignment="Center" Margin="0,0,18,0" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="pack://application:,,,/assets/icon.png" Width="24" Height="24" Margin="0,0,8,0" />
          <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Header}" VerticalAlignment="Center">
            <Run Text="borderless" /><Run Text="MAX" Foreground="{StaticResource Accent}" />
          </TextBlock>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="300" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>

      <!-- games, right -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}" Text="{Binding [games], Source={x:Static local:L.I}}" />
          <Button DockPanel.Dock="Bottom" Style="{StaticResource GreyButton}" HorizontalAlignment="Left" MinHeight="38" Margin="0,4,0,0"
                  Click="Add_Click" AutomationProperties.Name="{Binding [add_game], Source={x:Static local:L.I}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="+" FontSize="18" Margin="0,-3,8,0" />
              <TextBlock Text="{Binding [add_game], Source={x:Static local:L.I}}" />
            </StackPanel>
          </Button>
          <Grid>
            <TextBlock Text="{Binding [no_games], Source={x:Static local:L.I}}" Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Visibility="{Binding NoGames, Converter={StaticResource Vis}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
              <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" />
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>

      <!-- settings, left -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- default resolution for every game without its own -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Title}" Text="{Binding [default_res], Source={x:Static local:L.I}}" />
              <ContentControl Content="{Binding Default}" ContentTemplate="{StaticResource ResolutionPicker}" Focusable="False" />
              <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding [default_hint], Source={x:Static local:L.I}}" />
            </StackPanel>
          </Border>
          <!-- taskbar -->
          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Title}" Text="{Binding [taskbar], Source={x:Static local:L.I}}" />
              <TextBlock Style="{StaticResource Label}" Text="{Binding [hide_on], Source={x:Static local:L.I}}" />
              <ComboBox SelectedIndex="{Binding ScopeIndex}" AutomationProperties.Name="{Binding [hide_on], Source={x:Static local:L.I}}">
                <ComboBoxItem Content="{Binding [game_screen], Source={x:Static local:L.I}}" />
                <ComboBoxItem Content="{Binding [all_screens], Source={x:Static local:L.I}}" />
              </ComboBox>
              <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Stretch}" Margin="0,18,0,8"
                        Content="{Binding [stretch], Source={x:Static local:L.I}}" />
              <TextBlock Style="{StaticResource Hint}" Text="{Binding [stretch_hint], Source={x:Static local:L.I}}" />
            </StackPanel>
          </Border>
          <!-- general -->
          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Title}" Text="{Binding [general], Source={x:Static local:L.I}}" />
              <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Autostart}" Margin="0,0,0,8"
                        Content="{Binding [autostart], Source={x:Static local:L.I}}" />
              <TextBlock Style="{StaticResource Hint}" Text="{Binding [autostart_hint], Source={x:Static local:L.I}}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- install / update, version -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Style="{StaticResource GreenButton}" Content="{Binding ActionText}" Margin="0,0,12,0"
              Visibility="{Binding ShowAction, Converter={StaticResource Vis}}" IsEnabled="{Binding ActionEnabled}" Click="Action_Click" />
      <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
