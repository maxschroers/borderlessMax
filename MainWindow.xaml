<Window x:Class="BorderlessMax.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BorderlessMax"
        Style="{StaticResource Win}" Title="borderlessMax" Width="1130" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <!-- like the NVIDIA app: icon rail left, games as list + details, settings on their own page -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="100" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- rail: logo, pages, version -->
    <DockPanel Background="{StaticResource Rail}">
      <Image DockPanel.Dock="Top" Source="pack://application:,,,/assets/icon.png" Width="32" Height="32" Margin="0,16,0,16" />
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionText}" Foreground="{StaticResource Muted}" FontSize="12"
                 HorizontalAlignment="Center" Margin="0,0,0,12" />
      <StackPanel>
        <RadioButton x:Name="navGames" Style="{StaticResource Nav}" Tag="&#xE7FC;" IsChecked="True"
                     Content="{Binding [games], Source={x:Static local:L.I}}" />
        <RadioButton x:Name="navSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Margin="0,4,0,0"
                     Content="{Binding [settings], Source={x:Static local:L.I}}" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Column="1" Margin="24,16,24,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- header: page title, install / update -->
      <DockPanel Margin="0,0,0,16">
        <Button DockPanel.Dock="Right" Style="{StaticResource GreenButton}" Content="{Binding ActionText}"
                Visibility="{Binding ShowAction, Converter={StaticResource Vis}}" IsEnabled="{Binding ActionEnabled}" Click="Action_Click" />
        <Grid>
          <TextBlock Style="{StaticResource Title}" Margin="0" VerticalAlignment="Center" Text="{Binding [games], Source={x:Static local:L.I}}"
                     Visibility="{Binding IsChecked, ElementName=navGames, Converter={StaticResource Vis}}" />
          <TextBlock Style="{StaticResource Title}" Margin="0" VerticalAlignment="Center" Text="{Binding [settings], Source={x:Static local:L.I}}"
                     Visibility="{Binding IsChecked, ElementName=navSettings, Converter={StaticResource Vis}}" />
        </Grid>
      </DockPanel>

      <!-- games: list left, the selected game's settings right (saved as you type) -->
      <Grid Grid.Row="1" Visibility="{Binding IsChecked, ElementName=navGames, Converter={StaticResource Vis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="0,12">
          <DockPanel>
            <Button DockPanel.Dock="Top" Style="{StaticResource GreyButton}" HorizontalAlignment="Stretch" MinHeight="38" Margin="12,0,12,8"
                    Click="Add_Click" AutomationProperties.Name="{Binding [add_game], Source={x:Static local:L.I}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE710;" FontFamily="{StaticResource Glyphs}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding [add_game], Source={x:Static local:L.I}}" />
              </StackPanel>
            </Button>
            <Grid>
              <TextBlock Text="{Binding [no_games], Source={x:Static local:L.I}}" Style="{StaticResource Hint}" Margin="16,4"
                         Visibility="{Binding NoGames, Converter={StaticResource Vis}}" />
              <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                       ItemContainerStyle="{StaticResource Rows}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="{Binding [games], Source={x:Static local:L.I}}">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:GameRow}">
                    <DockPanel>
                      <Image Source="{Binding Icon, TargetNullValue={StaticResource AppGlyph}}" Width="32" Height="32" Margin="0,0,12,0" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding SizeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SizeInfo, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                    </DockPanel>
                    <DataTemplate.Triggers>
                      <!-- switched off: dimmed -->
                      <DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Opacity" Value="0.45" /></DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20" DataContext="{Binding Selected}"
                Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <!-- head: icon, name, on / off -->
              <DockPanel Margin="0,0,0,20">
                <Image Source="{Binding Icon, TargetNullValue={StaticResource AppGlyph}}" Width="48" Height="48" Margin="0,0,16,0" />
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                          Content="{Binding [enabled], Source={x:Static local:L.I}}" />
                <TextBlock Style="{StaticResource Title}" Margin="0,0,16,0" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </DockPanel>

              <TextBlock Style="{StaticResource Label}" Text="{Binding [name], Source={x:Static local:L.I}}" />
              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                       AutomationProperties.Name="{Binding [name], Source={x:Static local:L.I}}" />

              <TextBlock Style="{StaticResource Label}" Margin="0,16,0,8" Text="{Binding [exe], Source={x:Static local:L.I}}" />
              <TextBox Text="{Binding Exe, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                       AutomationProperties.Name="{Binding [exe], Source={x:Static local:L.I}}" />
              <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding [exe_hint], Source={x:Static local:L.I}}" />

              <TextBlock Style="{StaticResource Label}" Margin="0,16,0,8" Text="{Binding [resolution], Source={x:Static local:L.I}}" />
              <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseDefault}" Content="{Binding DefaultText}" Margin="0,0,0,12" />
              <ContentControl Content="{Binding Choice}" ContentTemplate="{StaticResource ResolutionPicker}" Focusable="False"
                              IsEnabled="{Binding OwnSize}" />

              <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Style="{StaticResource GreyButton}" MinHeight="38" Click="Icon_Click"
                        Content="{Binding [change_icon], Source={x:Static local:L.I}}" />
                <Button Style="{StaticResource GreyButton}" MinHeight="38" Margin="8,0,0,0" Click="Remove_Click"
                        Content="{Binding [remove], Source={x:Static local:L.I}}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- settings -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding IsChecked, ElementName=navSettings, Converter={StaticResource Vis}}">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
          <!-- default resolution for every game without its own -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Title}" Text="{Binding [default_res], Source={x:Static local:L.I}}" />
              <ContentControl Content="{Binding Default}" ContentTemplate="{StaticResource ResolutionPicker}" Focusable="False" />
              <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding [default_hint], Source={x:Static local:L.I}}" />
            </StackPanel>
          </Border>
          <!-- taskbar -->
          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Title}" Text="{Binding [taskbar], Source={x:Static local:L.I}}" />
              <TextBlock Style="{StaticResource Label}" Text="{Binding [taskbar_mode], Source={x:Static local:L.I}}" />
              <ComboBox SelectedIndex="{Binding ModeIndex}" AutomationProperties.Name="{Binding [taskbar_mode], Source={x:Static local:L.I}}">
                <ComboBoxItem Content="{Binding [mode_behind], Source={x:Static local:L.I}}" />
                <ComboBoxItem Content="{Binding [mode_hide], Source={x:Static local:L.I}}" />
              </ComboBox>
              <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding [mode_hint], Source={x:Static local:L.I}}" />
              <!-- only for hiding: which screens, stretching -->
              <StackPanel Margin="0,16,0,0" Visibility="{Binding Hiding, Converter={StaticResource Vis}}">
                <TextBlock Style="{StaticResource Label}" Text="{Binding [hide_on], Source={x:Static local:L.I}}" />
                <ComboBox SelectedIndex="{Binding ScopeIndex}" AutomationProperties.Name="{Binding [hide_on], Source={x:Static local:L.I}}">
                  <ComboBoxItem Content="{Binding [game_screen], Source={x:Static local:L.I}}" />
                  <ComboBoxItem Content="{Binding [all_screens], Source={x:Static local:L.I}}" />
                </ComboBox>
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Stretch}" Margin="0,18,0,8"
                          Content="{Binding [stretch], Source={x:Static local:L.I}}" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding [stretch_hint], Source={x:Static local:L.I}}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <!-- general: autostart, language -->
          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Title}" Text="{Binding [general], Source={x:Static local:L.I}}" />
              <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Autostart}" Margin="0,0,0,8"
                        Content="{Binding [autostart], Source={x:Static local:L.I}}" />
              <TextBlock Style="{StaticResource Hint}" Text="{Binding [autostart_hint], Source={x:Static local:L.I}}" />
              <TextBlock Style="{StaticResource Label}" Margin="0,16,0,8" Text="{Binding [language], Source={x:Static local:L.I}}" />
              <ComboBox Width="200" HorizontalAlignment="Left" ItemsSource="{Binding LangItems}" SelectedValuePath="Code"
                        SelectedValue="{Binding Lang}" AutomationProperties.Name="{Binding [language], Source={x:Static local:L.I}}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Image Source="{Binding Flag}" Width="22" Height="15" Margin="0,0,10,0" />
                      <TextBlock Text="{Binding Name}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
