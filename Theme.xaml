<!-- Discord dark theme, same palette and shapes as captureMax (github.com/maxschroers/captureMax, capturemax.py) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:BorderlessMax">

  <Color x:Key="AccentColor">#5865f2</Color>
  <SolidColorBrush x:Key="Accent" Color="#5865f2" />
  <SolidColorBrush x:Key="AccentHover" Color="#4752c4" />
  <SolidColorBrush x:Key="AccentDeep" Color="#3c45a5" />
  <SolidColorBrush x:Key="Bg" Color="#1a1a1e" />
  <SolidColorBrush x:Key="Surface" Color="#202024" />
  <SolidColorBrush x:Key="Field" Color="#1c1c20" />
  <SolidColorBrush x:Key="Border" Color="#343439" />
  <SolidColorBrush x:Key="BorderHover" Color="#4a4a50" />
  <SolidColorBrush x:Key="Track" Color="#3f3f46" />
  <SolidColorBrush x:Key="Text" Color="#dbdee1" />
  <SolidColorBrush x:Key="Header" Color="#f2f3f5" />
  <SolidColorBrush x:Key="Muted" Color="#94959c" />
  <SolidColorBrush x:Key="Dim" Color="#5c5d63" />
  <SolidColorBrush x:Key="Green" Color="#23a55a" />
  <SolidColorBrush x:Key="GreenHover" Color="#1a7f45" />
  <SolidColorBrush x:Key="Focus" Color="#00a8fc" />
  <SolidColorBrush x:Key="Err" Color="#f23f43" />
  <SolidColorBrush x:Key="GreyFill" Color="#2e2e33" />
  <SolidColorBrush x:Key="GreyFillHover" Color="#3a3a40" />
  <SolidColorBrush x:Key="Menu" Color="#28282d" />
  <SolidColorBrush x:Key="MenuBorder" Color="#35353b" />
  <SolidColorBrush x:Key="RowHover" Color="#35353b" />
  <SolidColorBrush x:Key="RowSelected" Color="#3e3e44" />
  <SolidColorBrush x:Key="RowText" Color="#abacb2" />
  <FontFamily x:Key="Font">Segoe UI Variable Text, Segoe UI</FontFamily>
  <BooleanToVisibilityConverter x:Key="Vis" />

  <!-- chevron like captureMax's assets/chevron.svg -->
  <Geometry x:Key="Chevron">M4,6 L8,10 L12,6</Geometry>
  <Geometry x:Key="Check">M5,8.5 L7.2,10.7 L11.2,5.8</Geometry>
  <Geometry x:Key="Cross">M4,4 L12,12 M12,4 L4,12</Geometry>
  <Geometry x:Key="Pencil">M3,13 L3,11 L10.5,3.5 L12.5,5.5 L5,13Z M9,5 L11,7</Geometry>

  <Style x:Key="Win" TargetType="Window">
    <Setter Property="Background" Value="{StaticResource Bg}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style x:Key="Title" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Header}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Header}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- focus ring: the blue keyboard focus border of captureMax (WCAG 2.4.7) -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{StaticResource Focus}" BorderThickness="2" CornerRadius="8" Margin="-2" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- buttons: blurple primary, green install / update, grey secondary, flat icon -->
  <Style x:Key="ButtonBase" TargetType="Button">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="MinHeight" Value="40" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHover}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource AccentDeep}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="#785865f2" />
        <Setter Property="Foreground" Value="#78ffffff" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource Green}" />
    <Setter Property="FontSize" Value="13" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource GreenHover}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="GreyButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource GreyFill}" />
    <Setter Property="MinWidth" Value="90" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource GreyFillHover}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#1affffff" />
        <Setter Property="Foreground" Value="White" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- text field: same box as the dropdowns -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource Field}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="CaretBrush" Value="{StaticResource Text}" />
    <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
            <!-- no Margin: WPF already applies the TextBox's Padding inside the content host -->
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderHover}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Focus}" /></Trigger>
            <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Err}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
  </Style>

  <!-- Discord's thin scroller: no arrows, no track, a slim round light thumb -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4,2,4">
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource Muted}" CornerRadius="3" MinHeight="32" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- dropdown: dark box, 1px border, chevron; list like Discord's picker with a blurple check on the chosen row -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource RowText}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <DockPanel>
              <Grid x:Name="check" DockPanel.Dock="Right" Width="18" Height="18" Margin="12,0,0,0" Visibility="Collapsed">
                <Ellipse Fill="{StaticResource Accent}" />
                <Path Data="{StaticResource Check}" Stroke="White" StrokeThickness="1.8" Margin="1,1,0,0"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Grid>
              <ContentPresenter VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource RowHover}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource RowSelected}" />
              <Setter Property="Foreground" Value="White" />
              <Setter TargetName="check" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="bd" Background="{StaticResource Field}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                    <Path x:Name="arrow" Data="{StaticResource Chevron}" Stroke="{StaticResource Text}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="16" Height="16" HorizontalAlignment="Right" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderHover}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderHover}" />
                      <Setter TargetName="arrow" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleY="-1" /></Setter.Value></Setter>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Border x:Name="focus" BorderBrush="{StaticResource Focus}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False" />
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="12,0,36,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="8"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="{StaticResource Menu}" BorderBrush="{StaticResource MenuBorder}" BorderThickness="1" CornerRadius="8"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <ScrollViewer Margin="0,4">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Dim}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="MaxDropDownHeight" Value="320" />
  </Style>

  <!-- pill switch with text, captureMax's Toggle: blurple when on, the knob slides -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Header}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="track" Width="40" Height="24" CornerRadius="12" Background="{StaticResource Track}">
              <Ellipse x:Name="knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="slide" X="0" /></Ellipse.RenderTransform>
              </Ellipse>
            </Border>
            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}" />
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="#111214" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,6">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- list rows in the picker: like the dropdown rows, full width -->
  <Style x:Key="Rows" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource RowText}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource RowHover}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource RowSelected}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- resolution dropdown (display modes + "Custom…"), custom width / height fields under it -->
  <DataTemplate x:Key="ResolutionItem" DataType="{x:Type local:Resolution}">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding Size, Mode=OneWay}" />
      <TextBlock Text="{Binding Info, Mode=OneWay}" Foreground="{StaticResource Muted}" FontWeight="Normal" FontSize="13"
                 Margin="8,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="ResolutionPicker" DataType="{x:Type local:ResolutionChoice}">
    <StackPanel>
      <ComboBox ItemTemplate="{StaticResource ResolutionItem}" SelectedItem="{Binding Selected}"
                ItemsSource="{x:Static local:Displays.Choices}" />
      <Grid Margin="0,8,0,0" Visibility="{Binding IsCustom, Converter={StaticResource Vis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Width" />
        <TextBlock Grid.Column="1" Text="x" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0" />
        <TextBox Grid.Column="2" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Height" />
      </Grid>
    </StackPanel>
  </DataTemplate>

  <!-- stand-in for apps without an icon: a grey window -->
  <DrawingImage x:Key="AppGlyph">
    <DrawingImage.Drawing>
      <GeometryDrawing Brush="#2e2e33" Geometry="M3,5 A2,2 0 0 1 5,3 H19 A2,2 0 0 1 21,5 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19Z">
        <GeometryDrawing.Pen><Pen Brush="#5c5d63" Thickness="1.5" /></GeometryDrawing.Pen>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- flags as in captureMax (3:2, Windows has no flag emoji) -->
  <DrawingImage x:Key="Flag_de">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#ffce00" Geometry="M0,0 H60 V40 H0Z" />
        <GeometryDrawing Brush="#dd0000" Geometry="M0,0 H60 V26.7 H0Z" />
        <GeometryDrawing Brush="#000000" Geometry="M0,0 H60 V13.3 H0Z" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
  <DrawingImage x:Key="Flag_en">
    <DrawingImage.Drawing>
      <DrawingGroup ClipGeometry="M0,0 H60 V40 H0Z">
        <GeometryDrawing Brush="#012169" Geometry="M0,0 H60 V40 H0Z" />
        <GeometryDrawing Geometry="M0,0 L60,40 M60,0 L0,40"><GeometryDrawing.Pen><Pen Brush="White" Thickness="8" /></GeometryDrawing.Pen></GeometryDrawing>
        <GeometryDrawing Geometry="M0,0 L60,40 M60,0 L0,40"><GeometryDrawing.Pen><Pen Brush="#c8102e" Thickness="3" /></GeometryDrawing.Pen></GeometryDrawing>
        <GeometryDrawing Geometry="M30,0 V40 M0,20 H60"><GeometryDrawing.Pen><Pen Brush="White" Thickness="12" /></GeometryDrawing.Pen></GeometryDrawing>
        <GeometryDrawing Geometry="M30,0 V40 M0,20 H60"><GeometryDrawing.Pen><Pen Brush="#c8102e" Thickness="7" /></GeometryDrawing.Pen></GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>
