<Window x:Class="BorderlessMax.AppPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BorderlessMax"
        Style="{StaticResource Win}" Title="{Binding [picker], Source={x:Static local:L.I}}"
        Width="640" Height="620" MinWidth="480" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Style="{StaticResource Title}" Text="{Binding [picker], Source={x:Static local:L.I}}" />

    <Grid Grid.Row="1">
      <TextBox x:Name="search" TextChanged="Search_Changed" PreviewKeyDown="Search_Keys"
               AutomationProperties.Name="{Binding [search], Source={x:Static local:L.I}}" />
      <TextBlock x:Name="placeholder" Text="{Binding [search], Source={x:Static local:L.I}}" Foreground="{StaticResource Dim}"
                 FontSize="15" FontWeight="SemiBold" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>

    <Border Grid.Row="2" Margin="0,12" Background="{StaticResource Menu}" BorderBrush="{StaticResource MenuBorder}" BorderThickness="1"
            CornerRadius="8" Padding="0,4">
      <Grid>
        <ListBox x:Name="list" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Rows}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.ScrollUnit="Pixel" MouseDoubleClick="List_DoubleClick" KeyDown="List_Keys"
                 SelectionChanged="List_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type local:AppEntry}">
              <DockPanel>
                <Image Source="{Binding Icon, TargetNullValue={StaticResource AppGlyph}}" Width="28" Height="28" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="note" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <DockPanel Grid.Row="3">
      <Button DockPanel.Dock="Right" x:Name="add" Style="{StaticResource Primary}" MinHeight="38" MinWidth="120" IsEnabled="False"
              Click="Add_Click" Content="{Binding [add_game], Source={x:Static local:L.I}}" />
      <Button Style="{StaticResource GreyButton}" MinHeight="38" HorizontalAlignment="Left" Click="Browse_Click"
              Content="{Binding [browse], Source={x:Static local:L.I}}" />
    </DockPanel>
  </Grid>
</Window>
